# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# GitHub
GITHUB_TOKEN=your_github_token
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# OpenAI (pour les agents IA)
OPENAI_API_KEY=your_openai_api_key

# Anthropic Claude (pour les agents IA avancés)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Provider IA par défaut: 'openai' | 'anthropic' | 'both'
AI_PROVIDER=both

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# Sécurité - CSRF Secret (32+ caractères)
CSRF_SECRET=generate-a-random-32-character-secret-key-here

# JWT Secret pour Supabase Auth
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# Rate Limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_BLOCK_DURATION=60
